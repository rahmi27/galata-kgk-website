# Required for Vercel production deployments
# Neon "Pooled connection" URL used by Prisma Client at runtime.
# The hostname must contain "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=verify-full"

# Neon "Direct connection" URL for the same branch, database and role.
# prisma.config.ts passes this URL to Prisma CLI, including `prisma migrate deploy`.
# The hostname must NOT contain "-pooler". Define this for Production and use a
# separate Neon branch/database for Preview deployments.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full"
AUTH_SECRET="replace-with-a-long-random-secret"
# Optional: separate HMAC key for hashing form rate-limit IP identifiers.
# When omitted, AUTH_SECRET is used. Never expose this value to the browser.
# FORM_RATE_LIMIT_SECRET="replace-with-another-long-random-secret"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_replace-with-your-token"
# OIDC bağlantılı yeni Blob mağazalarında uzun ömürlü token yerine mağaza
# kimliği kullanılabilir; VERCEL_OIDC_TOKEN değerini Vercel otomatik sağlar.
# BLOB_STORE_ID="store_replace-with-your-store-id"
# Public verification key used to notify IndexNow-compatible search engines
INDEXNOW_KEY="replace-with-an-8-to-128-character-random-key"

# Required only while running `npx prisma db seed`
ADMIN_SEED_PASSWORD="replace-with-a-strong-temporary-password"

# Optional local development settings
DEV_TUNNEL_ORIGINS="*.ngrok-free.dev,*.ngrok.app,*.ngrok.io,*.trycloudflare.com"

# Optional canonical URL override. The application already falls back to the
# production .com domain; set this only when deploying under another canonical.
# NEXT_PUBLIC_SITE_URL="https://galatakariyervegirisimcilik.com"

# ZeptoMail is used only for transactional, server-side form notifications.
# Keep its per-application SMTP token in Vercel Production secrets; never expose
# it with a NEXT_PUBLIC_ prefix. The regular Zoho Mail inbox remains separate.
SMTP_HOST="smtp.zeptomail.eu"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="emailapikey"
SMTP_PASSWORD="replace-with-the-zeptomail-smtp-token"
MAIL_FROM_ADDRESS="info@galatakariyervegirisimcilik.com"
MAIL_FROM_NAME="Galata KGK Web Sitesi"
MAIL_NOTIFICATION_TO="info@galatakariyervegirisimcilik.com"
