{
  "name": "galata-kgk-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && prisma migrate deploy && npm run db:seed-content && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test:security": "tsx --test tests/security/input-security.test.ts && node --test tests/security/admin-authorization.test.mjs tests/security/security-surface.test.mjs",
    "test:i18n": "tsx --test tests/localized-content.test.ts && node --test tests/i18n-routing.test.mjs",
    "test:team": "tsx --test tests/person-priority.test.ts && node --test tests/team-membership-integrity.test.mjs",
    "db:seed": "prisma db seed",
    "db:seed-content": "tsx scripts/seed-site-content.ts",
    "db:translate-content": "tsx scripts/backfill-english-content.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.19",
    "@radix-ui/react-slot": "^1.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "next": "^16.2.11",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.13.7",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "postcss": "8.5.25",
    "prisma": "^7.9.1",
    "tailwindcss": "3.4.19",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "find-my-way": "9.7.0",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "browserslist": {
    "production": [
      "Chrome >= 111",
      "Edge >= 111",
      "Firefox >= 111",
      "Safari >= 16.4"
    ],
    "development": [
      "last 1 Chrome version",
      "last 1 Edge version",
      "last 1 Firefox version",
      "last 1 Safari version"
    ]
  }
}
