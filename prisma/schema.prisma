generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SiteContentType {
  text
  richtext
  image
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model AdminLoginAttempt {
  id        Int      @id @default(autoincrement())
  username  String
  ipAddress String
  createdAt DateTime @default(now())

  @@index([username, ipAddress, createdAt])
}

model Event {
  id              Int       @id @default(autoincrement())
  title           String
  slug            String    @unique
  description     String
  longDescription String
  date            DateTime?
  location        String
  imageUrl        String?
  imageAlt        String?
  category        String
  createdAt       DateTime  @default(now())

  @@index([date])
}

model Person {
  id             Int              @id @default(autoincrement())
  name           String
  normalizedName String           @unique
  photoUrl       String?
  photoAlt       String?
  department     String           @default("Belirtilmedi")
  socialPlatform String?
  socialUrl      String?
  createdAt      DateTime         @default(now())
  memberships    TeamMembership[]

  @@index([name])
}

model TeamMembership {
  id         Int          @id @default(autoincrement())
  personId   Int
  categoryId Int
  role       String
  order      Int
  createdAt  DateTime     @default(now())
  person     Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  category   TeamCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([personId, categoryId])
  @@index([categoryId, order])
  @@index([personId])
}

model ClubSocialLink {
  id        Int      @id @default(autoincrement())
  platform  String   @unique
  label     String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model TeamCategory {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  slug        String           @unique
  order       Int
  memberships TeamMembership[]

  @@index([order])
}

model Sponsor {
  id          Int         @id @default(autoincrement())
  name        String
  logoUrl     String?
  logoAlt     String?
  websiteUrl  String?
  description String?
  order       Int
  createdAt   DateTime    @default(now())
  tierId      Int
  tier        SponsorTier @relation(fields: [tierId], references: [id], onDelete: Restrict)

  @@index([tierId, order])
}

model SponsorTier {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  slug     String    @unique
  order    Int
  sponsors Sponsor[]

  @@index([order])
}

model PartnerClub {
  id               Int                 @id @default(autoincrement())
  name             String
  slug             String              @unique
  logoUrl          String
  logoAlt          String?
  shortDescription String
  order            Int
  createdAt        DateTime            @default(now())
  collaborations   CollaborationItem[]

  @@index([order])
}

model CollaborationItem {
  id            Int         @id @default(autoincrement())
  partnerClubId Int
  title         String
  description   String
  date          DateTime?
  order         Int
  createdAt     DateTime    @default(now())
  partnerClub   PartnerClub @relation(fields: [partnerClubId], references: [id], onDelete: Cascade)

  @@index([partnerClubId, date, order])
}

model ContactSubmission {
  id                    Int       @id @default(autoincrement())
  name                  String
  email                 String
  message               String
  createdAt             DateTime  @default(now())
  isRead                Boolean   @default(false)
  privacyNoticeVersion  String?
  privacyAcknowledgedAt DateTime?
  ipHash                String?

  @@index([email, createdAt])
  @@index([ipHash, createdAt])
}

model MembershipApplication {
  id                    Int       @id @default(autoincrement())
  fullName              String
  email                 String
  studentNumber         String?
  department            String
  phone                 String?
  motivation            String
  createdAt             DateTime  @default(now())
  status                String    @default("beklemede")
  privacyNoticeVersion  String?
  privacyAcknowledgedAt DateTime?
  ipHash                String?

  @@index([email, createdAt])
  @@index([ipHash, createdAt])
}

model SiteStat {
  id    Int    @id @default(autoincrement())
  label String
  value String
  order Int

  @@index([order])
}

model SiteContent {
  id        Int             @id @default(autoincrement())
  key       String          @unique
  value     String          @db.Text
  type      SiteContentType @default(text)
  page      String
  label     String
  updatedAt DateTime        @updatedAt

  @@index([page])
}
