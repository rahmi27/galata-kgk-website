generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SiteContentType {
  text
  richtext
  image
}

enum PosterOrientation {
  portrait
  landscape
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model AdminLoginAttempt {
  id        Int      @id @default(autoincrement())
  username  String
  ipAddress String
  createdAt DateTime @default(now())

  @@index([username, ipAddress, createdAt])
}

model Event {
  id                Int            @id @default(autoincrement())
  title             String
  titleEn           String?
  slug              String         @unique
  description       String
  descriptionEn     String?
  longDescription   String
  longDescriptionEn String?
  date              DateTime?
  location          String
  locationEn        String?
  imageUrl          String?
  imageAlt          String?
  imageAltEn        String?
  category          String
  categoryEn        String?
  createdAt         DateTime       @default(now())
  eventSessions     EventSession[]

  @@index([date])
}

model EventSession {
  id                         Int                @id @default(autoincrement())
  isActive                   Boolean            @default(false)
  linkedEventId              Int?
  title                      String
  posterImageUrl             String?
  posterOrientation          PosterOrientation  @default(portrait)
  badgeTemplateUrl           String?
  namePositionYPercent       Int                @default(60)
  eventTitlePositionYPercent Int                @default(72)
  showLiveCountersPublicly   Boolean            @default(false)
  quizEnabled                Boolean            @default(false)
  raffleEnabled              Boolean            @default(false)
  joinButtonEnabled          Boolean            @default(false)
  feedbackEnabled            Boolean            @default(false)
  badgeEnabled               Boolean            @default(false)
  pollEnabled                Boolean            @default(false)
  createdAt                  DateTime           @default(now())
  linkedEvent                Event?             @relation(fields: [linkedEventId], references: [id], onDelete: SetNull)
  participants               EventParticipant[]
  quizzes                    Quiz[]
  raffleEntries              RaffleEntry[]
  raffleWinners              RaffleWinner[]
  feedback                   Feedback[]
  polls                      Poll[]

  @@index([isActive])
  @@index([linkedEventId])
}

model EventParticipant {
  id                Int           @id @default(autoincrement())
  eventSessionId    Int
  fullName          String
  email             String
  department        String
  consentAcceptedAt DateTime
  createdAt         DateTime      @default(now())
  eventSession      EventSession  @relation(fields: [eventSessionId], references: [id], onDelete: Cascade)
  quizAnswers       QuizAnswer[]
  raffleEntries     RaffleEntry[]
  feedback          Feedback[]
  pollVotes         PollVote[]

  @@unique([eventSessionId, email])
  @@index([eventSessionId, createdAt])
}

model Quiz {
  id             Int            @id @default(autoincrement())
  eventSessionId Int
  title          String
  isActive       Boolean        @default(false)
  eventSession   EventSession   @relation(fields: [eventSessionId], references: [id], onDelete: Cascade)
  questions      QuizQuestion[]

  @@index([eventSessionId, isActive])
}

model QuizQuestion {
  id                 Int          @id @default(autoincrement())
  quizId             Int
  questionText       String
  options            Json
  correctOptionIndex Int
  order              Int
  quiz               Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers            QuizAnswer[]

  @@index([quizId, order])
}

model QuizAnswer {
  id                  Int              @id @default(autoincrement())
  participantId       Int
  questionId          Int
  selectedOptionIndex Int
  isCorrect           Boolean
  answeredAt          DateTime         @default(now())
  participant         EventParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  question            QuizQuestion     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([participantId, questionId])
  @@index([questionId, isCorrect])
}

model RaffleEntry {
  id                Int              @id @default(autoincrement())
  eventSessionId    Int
  participantId     Int
  consentAcceptedAt DateTime
  createdAt         DateTime         @default(now())
  eventSession      EventSession     @relation(fields: [eventSessionId], references: [id], onDelete: Cascade)
  participant       EventParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  winner            RaffleWinner?

  @@unique([eventSessionId, participantId])
  @@index([eventSessionId, createdAt])
}

model RaffleWinner {
  id             Int          @id @default(autoincrement())
  eventSessionId Int
  raffleEntryId  Int          @unique
  drawnAt        DateTime     @default(now())
  eventSession   EventSession @relation(fields: [eventSessionId], references: [id], onDelete: Cascade)
  raffleEntry    RaffleEntry  @relation(fields: [raffleEntryId], references: [id], onDelete: Cascade)

  @@index([eventSessionId, drawnAt])
}

model Feedback {
  id             Int               @id @default(autoincrement())
  eventSessionId Int
  participantId  Int?
  rating         Int
  comment        String?           @db.Text
  createdAt      DateTime          @default(now())
  eventSession   EventSession      @relation(fields: [eventSessionId], references: [id], onDelete: Cascade)
  participant    EventParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@index([eventSessionId, createdAt])
  @@index([participantId])
}

model Poll {
  id             Int          @id @default(autoincrement())
  eventSessionId Int
  question       String
  isActive       Boolean      @default(false)
  eventSession   EventSession @relation(fields: [eventSessionId], references: [id], onDelete: Cascade)
  options        PollOption[]
  votes          PollVote[]

  @@index([eventSessionId, isActive])
}

model PollOption {
  id     Int        @id @default(autoincrement())
  pollId Int
  text   String
  order  Int
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  PollVote[]

  @@index([pollId, order])
}

model PollVote {
  id            Int              @id @default(autoincrement())
  pollId        Int
  pollOptionId  Int
  participantId Int
  createdAt     DateTime         @default(now())
  poll          Poll             @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollOption    PollOption       @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)
  participant   EventParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([pollId, participantId])
  @@index([pollOptionId])
}

model Person {
  id             Int              @id @default(autoincrement())
  name           String
  nameEn         String?
  normalizedName String           @unique
  photoUrl       String?
  photoAlt       String?
  photoAltEn     String?
  department     String           @default("Belirtilmedi")
  departmentEn   String?
  socialPlatform String?
  socialUrl      String?
  createdAt      DateTime         @default(now())
  memberships    TeamMembership[]

  @@index([name])
}

model TeamMembership {
  id         Int          @id @default(autoincrement())
  personId   Int
  categoryId Int
  role       String
  roleEn     String?
  order      Int
  createdAt  DateTime     @default(now())
  person     Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  category   TeamCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([personId, categoryId])
  @@index([categoryId, order])
  @@index([personId])
}

model ClubSocialLink {
  id        Int      @id @default(autoincrement())
  platform  String   @unique
  label     String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model TeamCategory {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  nameEn      String?
  slug        String           @unique
  order       Int
  memberships TeamMembership[]

  @@index([order])
}

model Sponsor {
  id            Int         @id @default(autoincrement())
  name          String
  nameEn        String?
  logoUrl       String?
  logoAlt       String?
  logoAltEn     String?
  websiteUrl    String?
  description   String?
  descriptionEn String?
  order         Int
  createdAt     DateTime    @default(now())
  tierId        Int
  tier          SponsorTier @relation(fields: [tierId], references: [id], onDelete: Restrict)

  @@index([tierId, order])
}

model SponsorTier {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  nameEn   String?
  slug     String    @unique
  order    Int
  sponsors Sponsor[]

  @@index([order])
}

model PartnerClub {
  id                 Int                 @id @default(autoincrement())
  name               String
  nameEn             String?
  slug               String              @unique
  logoUrl            String
  logoAlt            String?
  logoAltEn          String?
  shortDescription   String
  shortDescriptionEn String?
  order              Int
  createdAt          DateTime            @default(now())
  collaborations     CollaborationItem[]

  @@index([order])
}

model CollaborationItem {
  id            Int         @id @default(autoincrement())
  partnerClubId Int
  title         String
  titleEn       String?
  description   String
  descriptionEn String?
  date          DateTime?
  order         Int
  createdAt     DateTime    @default(now())
  partnerClub   PartnerClub @relation(fields: [partnerClubId], references: [id], onDelete: Cascade)

  @@index([partnerClubId, date, order])
}

model ContactSubmission {
  id                    Int       @id @default(autoincrement())
  name                  String
  email                 String
  message               String
  createdAt             DateTime  @default(now())
  isRead                Boolean   @default(false)
  privacyNoticeVersion  String?
  privacyAcknowledgedAt DateTime?
  ipHash                String?

  @@index([email, createdAt])
  @@index([ipHash, createdAt])
}

model MembershipApplication {
  id                    Int       @id @default(autoincrement())
  fullName              String
  email                 String
  studentNumber         String?
  department            String
  phone                 String?
  motivation            String
  createdAt             DateTime  @default(now())
  status                String    @default("beklemede")
  privacyNoticeVersion  String?
  privacyAcknowledgedAt DateTime?
  ipHash                String?

  @@index([email, createdAt])
  @@index([ipHash, createdAt])
}

model SiteStat {
  id      Int     @id @default(autoincrement())
  label   String
  labelEn String?
  value   String
  order   Int

  @@index([order])
}

model SiteContent {
  id        Int             @id @default(autoincrement())
  key       String          @unique
  value     String          @db.Text
  valueEn   String?         @db.Text
  type      SiteContentType @default(text)
  page      String
  label     String
  updatedAt DateTime        @updatedAt

  @@index([page])
}
